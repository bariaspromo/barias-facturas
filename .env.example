# Database Configuration
DB_PASSWORD=your_secure_password
DATABASE_URL=postgresql://barias:your_secure_password@db:5432/barias_erp

# Django Configuration
SECRET_KEY=your_django_secret_key_change_this_in_production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# DGII Configuration - República Dominicana
DGII_ENV=test  # test | production
DGII_RNC=your_company_rnc
DGII_CERT_PATH=/certs/dgii_cert.p12
DGII_CERT_PASSWORD=your_cert_password
DGII_API_URL=https://ecf.dgii.gov.do/

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_email_password

# WhatsApp API (optional for notifications)
WHATSAPP_API_KEY=your_whatsapp_api_key
WHATSAPP_PHONE_NUMBER=your_whatsapp_number

# Payment Gateway (optional)
PAYMENT_GATEWAY_API_KEY=your_payment_gateway_key
PAYMENT_GATEWAY_SECRET=your_payment_gateway_secret

# Multi-currency
DEFAULT_CURRENCY=DOP
BANCO_CENTRAL_API_KEY=your_banco_central_api_key

# Storage (optional - for S3/Cloud Storage)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_STORAGE_BUCKET_NAME=your_bucket_name
AWS_S3_REGION_NAME=us-east-1

# Sentry (optional - for error tracking)
SENTRY_DSN=your_sentry_dsn

# Analytics (optional)
GOOGLE_ANALYTICS_ID=your_ga_id

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
